<?xml version="1.0" encoding="UTF-8"?>
<!--
    Payara/GlassFish-specific deployment descriptor.
    Maps application security roles to Payara security groups.

    Critical Analysis — Role Mapping Strategy:
    Application roles defined in web.xml and ejb-jar.xml are abstract.
    This descriptor maps them to concrete security groups configured
    in Payara Server's security realm. This separation allows the same
    application to be deployed to different environments with different
    group structures without modifying application code.
-->
<!DOCTYPE glassfish-web-app PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Servlet 3.0//EN"
        "http://glassfish.org/dtds/glassfish-web-app_3_0-1.dtd">
<glassfish-web-app error-url="">

    <context-root>/globaltrade</context-root>

    <!-- Security role to Payara group mappings -->
    <security-role-mapping>
        <role-name>SYSTEM_ADMIN</role-name>
        <group-name>SYSTEM_ADMIN</group-name>
    </security-role-mapping>

    <security-role-mapping>
        <role-name>LOGISTICS_COORDINATOR</role-name>
        <group-name>LOGISTICS_COORDINATOR</group-name>
    </security-role-mapping>

    <security-role-mapping>
        <role-name>WAREHOUSE_MANAGER</role-name>
        <group-name>WAREHOUSE_MANAGER</group-name>
    </security-role-mapping>

    <security-role-mapping>
        <role-name>CUSTOMS_AGENT</role-name>
        <group-name>CUSTOMS_AGENT</group-name>
    </security-role-mapping>

    <security-role-mapping>
        <role-name>VENDOR_REPRESENTATIVE</role-name>
        <group-name>VENDOR_REPRESENTATIVE</group-name>
    </security-role-mapping>

</glassfish-web-app>
