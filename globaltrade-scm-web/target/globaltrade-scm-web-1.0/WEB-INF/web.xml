<?xml version="1.0" encoding="UTF-8"?>
<!--
    Web Deployment Descriptor for GlobalTrade SCM.

    Critical Analysis — JWT-based Authentication:
    This application uses JWT authentication for REST API endpoints instead of 
    container-managed FORM authentication. The JWTAuthenticationFilter handles
    authentication by validating Bearer tokens and populating the SecurityContext.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>GlobalTrade Supply Chain Management - Web</display-name>

    <!-- ======================== Welcome Files ======================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ======================== Security Constraints ======================== -->

    <!-- Authentication endpoints — public access for JWT authentication -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Authentication Resources</web-resource-name>
            <url-pattern>/api/auth/*</url-pattern>
        </web-resource-collection>
        <!-- No auth-constraint = public access -->
    </security-constraint>

    <!-- Health check — public access (no auth-constraint) -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Health Check</web-resource-name>
            <url-pattern>/api/health</url-pattern>
        </web-resource-collection>
        <!-- No auth-constraint = public access -->
    </security-constraint>

    <!-- ======================== Security Roles ======================== -->
    <security-role>
        <description>Full system access — user management, configuration, emergency overrides</description>
        <role-name>SYSTEM_ADMIN</role-name>
    </security-role>
    <security-role>
        <description>Shipment management, inventory operations, route optimization</description>
        <role-name>LOGISTICS_COORDINATOR</role-name>
    </security-role>
    <security-role>
        <description>Inventory management, warehouse operations</description>
        <role-name>WAREHOUSE_MANAGER</role-name>
    </security-role>
    <security-role>
        <description>Customs declarations, compliance reports</description>
        <role-name>CUSTOMS_AGENT</role-name>
    </security-role>
    <security-role>
        <description>View own orders, update delivery status</description>
        <role-name>VENDOR_REPRESENTATIVE</role-name>
    </security-role>

    <!-- ======================== Session Configuration ======================== -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
        <!-- Session cookie security: HttpOnly prevents XSS, Secure ensures HTTPS-only 
             SameSite attribute is set via SessionSecurityFilter for CSRF protection -->
    </session-config>

    <!-- ======================== Security Filters ======================== -->
    <!-- Session Security Filter for SameSite cookie attribute -->
    <filter>
        <filter-name>SessionSecurityFilter</filter-name>
        <filter-class>com.globaltrade.web.filter.SessionSecurityFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SessionSecurityFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ======================== JAX-RS Exception Mappers ======================== -->
    <!-- Exception mappers are automatically discovered via @Provider annotation -->
    <!-- No additional configuration needed for JAX-RS exception mapping -->

</web-app>