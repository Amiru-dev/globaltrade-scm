<?xml version="1.0" encoding="UTF-8"?>
<!--
    JPA Persistence Configuration for GlobalTrade SCM.
    Defines the persistence unit connecting to the MySQL datasource
    configured in Payara Server.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="GlobalTradePU" transaction-type="JTA">
        <description>GlobalTrade Supply Chain Management Persistence Unit</description>

        <!-- JNDI datasource configured in Payara Server -->
        <jta-data-source>jdbc/GlobalTradeDS</jta-data-source>

        <!-- Explicitly list entity classes for clarity -->
        <class>com.globaltrade.common.entity.Shipment</class>
        <class>com.globaltrade.common.entity.Vendor</class>
        <class>com.globaltrade.common.entity.InventoryItem</class>
        <class>com.globaltrade.common.entity.PurchaseOrder</class>
        <class>com.globaltrade.common.entity.CustomsDeclaration</class>
        <class>com.globaltrade.common.entity.Warehouse</class>
        <class>com.globaltrade.common.entity.CarrierRoute</class>
        <class>com.globaltrade.common.entity.AuditLog</class>

        <!-- Exclude unlisted classes to avoid unexpected entity discovery -->
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- EclipseLink (Payara default JPA provider) settings -->
            <property name="eclipselink.target-database" value="MySQL"/>
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>

            <!-- Schema generation: validate existing schema (do NOT auto-create in production) -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>

            <!-- Connection pool optimization -->
            <property name="eclipselink.jdbc.cache-statements" value="true"/>
            <property name="eclipselink.jdbc.cache-statements.size" value="100"/>

            <!-- Query result cache for frequently accessed read-only data -->
            <property name="eclipselink.query-results-cache" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
