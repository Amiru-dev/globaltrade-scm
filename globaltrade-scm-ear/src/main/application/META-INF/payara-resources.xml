<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC "-//Payara.fish//DTD Payara Server 4 Resources//EN"
"https://docs.payara.fish/schemas/payara-resources_5.dtd">
<resources>
    <!-- MySQL Datasource Configuration -->
    <!-- CRITICAL FIX: useSSL property name (not SSL) for MySQL Connector/J -->
    <jdbc-connection-pool name="GlobalTradePool"
                          datasource-classname="com.mysql.cj.jdbc.MysqlDataSource"
                          res-type="javax.sql.DataSource">
        <property name="Url" value="jdbc:mysql://localhost:3306/globaltrade_scm"/>
        <property name="User" value="globaltrade"/>
        <property name="Password" value="GlobalTrade@2026"/>
        <property name="DatabaseName" value="globaltrade_scm"/>
        <property name="ServerName" value="localhost"/>
        <property name="PortNumber" value="3306"/>
        <property name="useSSL" value="false"/>
    </jdbc-connection-pool>

    <jdbc-resource enabled="true"
                   jndi-name="jdbc/GlobalTradeDS"
                   pool-name="GlobalTradePool"/>
</resources>